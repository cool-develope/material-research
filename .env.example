# Production-ready compose + CLI.
# Pytest does not read this file (pins EMBEDDER=fake, RERANKER=off,
# ANALYZER=deterministic). Copy to .env, then `docker compose up -d`.

DATABASE_URL=postgresql+psycopg://material:material@localhost:5432/material

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_SECURE=false
MINIO_BUCKET=material

QDRANT_URL=http://localhost:6333
# Match EMBEDDER to the collection you ingested.
# AIML prod ingest uses research_aiml.
QDRANT_COLLECTION=research

# LangGraph: checkpoint in postgres database `langgraph`, store in
# Qdrant collection `langgraph` (same compose postgres + qdrant).
LANGGRAPH_DATABASE_URL=postgresql://material:material@localhost:5432/langgraph
LANGGRAPH_QDRANT_COLLECTION=langgraph

# Retrieval. Local BGE for now (FlagEmbedding + scripts/download_bge.py).
# Later: EMBEDDER=http EMBED_BASE_URL=http://embed:8000/v1
EMBEDDER=bge-m3
BGE_MODEL=BAAI/bge-m3
# EMBED_BASE_URL=
# EMBED_API_KEY=embed
# EMBED_MODEL=BAAI/bge-m3
# EMBED_TIMEOUT_SECONDS=120
BGE_RERANKER=BAAI/bge-reranker-v2-m3
# Hop-2 rerank: off | bge-v2-m3 | http  (`on` = local bge-v2-m3)
RERANKER=bge-v2-m3
# RERANK_BASE_URL=
# RERANK_API_KEY=rerank
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_TIMEOUT_SECONDS=120

# Analysis + Deep Research LLM (OpenAI-compatible).
ANALYZER=llm
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=120

# Deep Research agent traces. Keys match docker compose Langfuse init
# (http://localhost:3100). Leave empty to keep tracing off.
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_HOST=http://localhost:3100

# Analysis grouping (not retrieval chunk 512/64).
ANALYSIS_DIRECT_TOKENS=20000
ANALYSIS_LEAF_TOKENS=10000
ANALYSIS_REDUCE_FANIN=8
ANALYSIS_DEEP_FILES=20

# Deep Research agent: quick | standard | deep (does not change hop 1/2).
AGENT_MODE=standard

# Vite UI at http://localhost:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# HttpOnly session cookie. Set true behind HTTPS.
COOKIE_SECURE=false

# Query embedding + hop-1 SERP window. Same compose Redis as Langfuse.
# Search still works in memory if Redis is down.
REDIS_URL=redis://:langfuse@127.0.0.1:6379/0

WORKSPACE_ROOT=/tmp/material-platform
DISCOVERY_VERSION=boundary-v1
PIPELINE_VERSION=process-v1

# Dagster inbox: local folder or mounted FTP/storage share.
# One ingest_source_job per top-level zip. Archive is not stored in MinIO.
# INGEST_DIRECTORY=/home/cool/Workplaces/Deep-Research/inbox

MAX_ARCHIVE_DEPTH=5
MAX_ARCHIVE_FILES=10000
MAX_EXPANDED_BYTES=2147483648
MAX_MEMBER_BYTES=536870912
MAX_COMPRESSION_RATIO=200
MAX_ARCHIVE_TIMEOUT_SECONDS=60
