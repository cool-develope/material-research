    {
      "id": "paper-opening-paraphrase",
      "query": "what does the opening of this paper cover",
      "mode": "semantic",
      "expect": [{"path": "paper.pdf", "page": 1}]
    },
    {
      "id": "api-handler-paraphrase",
      "query": "where is the request handler defined",
      "mode": "semantic",
      "expect": [{"path": "src/api.py", "lines": true}]
    }
  ]
}
